APP_NAME="PRS System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development uses SQLite. Production runs on Azure SQL (sqlsrv).
# To use Azure SQL locally:
#   1. Install Microsoft ODBC Driver 18 for SQL Server
#   2. Install the PHP sqlsrv + pdo_sqlsrv extensions
#   3. Set DB_CONNECTION=sqlsrv and the values below
DB_CONNECTION=sqlite
# DB_CONNECTION=sqlsrv
# DB_HOST=prs-sql.database.windows.net
# DB_PORT=1433
# DB_DATABASE=prs
# DB_USERNAME=prs_app
# DB_PASSWORD=
# DB_ENCRYPT=yes
# DB_TRUST_SERVER_CERTIFICATE=false
# DB_QUERY_TIMEOUT=30

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gov.mt"
MAIL_FROM_NAME="${APP_NAME}"

# Auth enforcement: keep true in every deployed environment. Set false only
# for local scaffolding work when no users have been seeded yet.
PRS_REQUIRE_AUTH=true

# ---------------------------------------------------------------------------
# Azure Blob Storage — personnel documents, GP47 forms, attachments
# Either provide AZURE_STORAGE_CONNECTION_STRING (overrides), or set
# account + key. Production should prefer Managed Identity (set neither
# and configure DefaultAzureCredential server-side).
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=prs-documents
AZURE_STORAGE_ENDPOINT=
AZURE_STORAGE_PREFIX=

# ---------------------------------------------------------------------------
# Cloudflare — the public origin is fronted by Cloudflare WAF/CDN.
# Set the trusted proxy CIDR ranges so Laravel resolves the real client IP.
# ---------------------------------------------------------------------------
TRUSTED_PROXIES="*"

VITE_APP_NAME="${APP_NAME}"
